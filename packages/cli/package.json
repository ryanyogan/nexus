{
  "name": "nexus-cli",
  "version": "0.1.0",
  "description": "The Nexus CLI - Documentation search, skills, MCP servers, and more for AI assistants",
  "keywords": [
    "ai",
    "cli",
    "documentation",
    "llm",
    "mcp",
    "memory",
    "nexus",
    "skills"
  ],
  "homepage": "https://nexus.yogan.dev",
  "bugs": {
    "url": "https://github.com/ryanyogan/nexus/issues"
  },
  "license": "MIT",
  "author": "yogan.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanyogan/nexus",
    "directory": "packages/cli"
  },
  "bin": {
    "nexus": "./dist/index.js",
    "nxs": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vp test",
    "test:run": "vp test run",
    "lint": "vp lint src/",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@nexus/sdk": "workspace:*",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "conf": "^13.1.0",
    "execa": "^9.5.2",
    "figures": "^6.1.0",
    "fuse.js": "^7.1.0",
    "get-port": "^7.1.0",
    "ink": "^5.1.0",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "open": "^10.1.0",
    "react": "^18.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
