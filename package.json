{
  "name": "nexus",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter api build && pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "pnpm -r --parallel lint",
    "db:generate": "pnpm --filter @nexus/db db:generate",
    "db:migrate": "pnpm --filter api exec wrangler d1 migrations apply nexus-db --remote",
    "ship": "pnpm run build && pnpm run db:migrate && pnpm run ship:api && pnpm run ship:web",
    "ship:api": "pnpm --filter api run deploy",
    "ship:web": "pnpm --filter web run deploy"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["workerd"],
    "supportedArchitectures": {
      "os": ["linux"],
      "cpu": ["x64"]
    }
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  }
}
