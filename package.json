{
  "name": "nexus",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "ship": "turbo deploy",
    "db:generate": "turbo db:generate",
    "db:migrate": "pnpm --filter api exec wrangler d1 migrations apply nexus-db --remote",
    "deploy": "pnpm run typecheck && pnpm run build && pnpm run db:migrate && pnpm run deploy:api && pnpm run deploy:web",
    "deploy:api": "pnpm --filter api deploy",
    "deploy:web": "pnpm --filter web deploy"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["workerd"],
    "supportedArchitectures": {
      "os": ["linux"],
      "cpu": ["x64"]
    }
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  }
}
