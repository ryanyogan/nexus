{
  "name": "nexus",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev --filter=web --filter=api --filter=@nexus/docs",
    "dev:web": "turbo dev --filter=web...",
    "dev:api": "turbo dev --filter=api...",
    "dev:docs": "turbo dev --filter=@nexus/docs",
    "build": "turbo build",
    "build:web": "turbo build --filter=web...",
    "build:api": "turbo build --filter=api...",
    "build:docs": "turbo build --filter=@nexus/docs",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:run": "vp test run",
    "deploy": "turbo build && pnpm run db:migrate:remote && turbo deploy --filter=api --filter=web --filter=@nexus/docs",
    "deploy:api": "turbo deploy --filter=api",
    "deploy:web": "turbo deploy --filter=web",
    "deploy:docs": "turbo deploy --filter=@nexus/docs",
    "db:generate": "pnpm --filter @nexus/db db:generate",
    "db:migrate:local": "pnpm --filter api exec wrangler d1 migrations apply nexus-db --local --persist-to ../../.wrangler/state",
    "db:migrate:remote": "pnpm --filter api exec wrangler d1 migrations apply nexus-db --remote",
    "clean": "turbo clean && rm -rf .turbo node_modules",
    "prepare": "vp config"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "workerd"
    ],
    "supportedArchitectures": {
      "os": [
        "linux"
      ],
      "cpu": [
        "x64"
      ]
    }
  }
}
