# Development-only auth bypass - logs you in as Ryan (admin)
# This file is ONLY loaded by Vite in development mode
#
# SAFETY: This variable has NO effect in production because:
# 1. Vite only loads .env.development when NODE_ENV=development
# 2. The code also checks for localhost as a runtime failsafe
# 3. Production builds tree-shake out all dev bypass code
VITE_DEV_BYPASS_AUTH=true
