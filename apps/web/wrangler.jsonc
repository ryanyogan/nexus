{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus-web",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "routes": [
    { "pattern": "nexus.yogan.dev", "custom_domain": true }
  ],

  // D1 Database - direct access from web worker
  // Using remote: true to connect to production D1 during development
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexus-db",
      "database_id": "bf8148c0-b43e-4d09-bcee-d79d4760650e",
      "migrations_dir": "../../packages/db/migrations",
      "remote": true
    }
  ]
}
