{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,

    /* Path aliases */
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [".vitepress/**/*.ts", ".vitepress/**/*.vue", "**/*.md", "**/*.vue"],
  "exclude": ["node_modules", "docs", "src", ".docusaurus", ".astro", "build"]
}
